# Canonical production URL used by metadata, JSON-LD, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://taxivila.com

# Optional: Google Search Console verification token.
# GOOGLE_SITE_VERIFICATION=

# HTTPS receiver that delivers booking notifications to the responsible operator.
# Must return HTTP 2xx only after accepting the request for delivery.
# BOOKING_WEBHOOK_URL=
# Optional Bearer token for the receiver (server-only, never NEXT_PUBLIC_).
# BOOKING_WEBHOOK_TOKEN=
